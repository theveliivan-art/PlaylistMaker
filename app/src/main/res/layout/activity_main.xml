<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/MainTheme">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:textColor="@color/white"
        android:textSize="@dimen/main_text_22"
        android:text="@string/app_name"
        android:fontFamily="@font/ys_display_medium"
        android:textFontWeight="500"/>
    <Button style="@style/MainButtonStyle"
        android:id="@+id/main_search_button"
        android:text="@string/button_search_name"
        app:icon="@drawable/ic_search_24"
        />
    <Button style="@style/MainButtonStyle"
        android:id="@+id/main_media_button"
        android:text="@string/button_media_name"
        app:icon="@drawable/ic_media_24"
        />
    <Button style="@style/MainButtonStyle"
        android:id="@+id/main_settings_button"
        android:text="@string/button_settings_name"
        app:icon="@drawable/ic_settings_24"
        />

</androidx.appcompat.widget.LinearLayoutCompat>