<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/LightDarkTheme"
    tools:context=".SearchActivity">

    <LinearLayout style="@style/SettingsLinearLayoutStyle"
        android:layout_height="56dp"
        >
        <ImageView
            android:id="@+id/search_back_button"
            android:foreground="?attr/selectableItemBackground"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="@color/LightDarkFont"
            />

        <TextView style="@style/SettingsTextViewStyle"
            android:paddingLeft="12dp"
            android:text="@string/search_text_name"
            android:fontFamily="@font/ys_display_medium"
            android:textFontWeight="500"
            android:textSize="@dimen/main_text_22"
            />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <EditText style="@style/SettingsTextViewStyle"
            android:id="@+id/searchEditText"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:paddingStart="10dp"
            android:drawableStart="@drawable/ic_search_16"
            android:background="@drawable/search_edittext_rounded"
            android:hint="@string/search_text_hint"
            android:drawablePadding="8dp"
            android:textColor="@color/black"
            android:textColorHint="@color/editTextSearchHint"
            android:inputType="text"/>

        <ImageView
            android:id="@+id/clearIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:visibility="gone"
            android:src="@drawable/ic_clear_16"/>

    </FrameLayout>

</androidx.appcompat.widget.LinearLayoutCompat>