<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/LightDarkTheme"
    android:orientation="vertical"
    tools:context=".SearchActivity">

    <LinearLayout
        style="@style/SettingsLinearLayoutStyle"
        android:layout_height="56dp">

        <ImageView
            android:id="@+id/search_back_button"
            android:layout_width="@dimen/image_back_button_w_h"
            android:layout_height="@dimen/image_back_button_w_h"
            android:foreground="?attr/selectableItemBackground"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="@color/LightDarkFont" />

        <TextView
            style="@style/SettingsTextViewStyle"
            android:fontFamily="@font/ys_display_medium"
            android:paddingLeft="12dp"
            android:text="@string/search_text_name"
            android:textFontWeight="500"
            android:textSize="@dimen/main_text_22" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingLeft="@dimen/search_frame_padding_goriz"
        android:paddingTop="@dimen/search_frame_padding_vert"
        android:paddingRight="@dimen/search_frame_padding_goriz"
        android:paddingBottom="@dimen/search_frame_padding_vert">

        <EditText
            android:id="@+id/searchEditText"
            style="@style/SettingsTextViewStyle"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:background="@drawable/search_edittext_rounded"
            android:drawableStart="@drawable/ic_search_16"
            android:drawablePadding="8dp"
            android:drawableTint="@color/editTextSearchHint"
            android:hint="@string/search_text_hint"
            android:inputType="text"
            android:paddingStart="10dp"
            android:textColor="@color/black"
            android:textColorHint="@color/editTextSearchHint" />

        <ImageView
            android:id="@+id/clearIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_clear_16"
            android:visibility="gone"
            app:tint="@color/editTextSearchHint" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/search_nothing_linear"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:gravity="center">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_nothing_search_120" />
        <TextView
            style="@style/SearchErrorTextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/search_text_nothing"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/search_internet_problem"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:gravity="center"
        >

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_internet_problem_120" />
        <TextView
            style="@style/SearchErrorTextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/search_text_internet_problem"/>
        <TextView
            style="@style/SearchErrorTextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="24dp"
            android:text="@string/search_text_check_internet"/>

        <Button
            android:id="@+id/search_button_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/errorSearch"
            android:fontFamily="@font/ys_display_medium"
            android:textFontWeight="500"
            android:textSize="@dimen/search_text_14"
            android:textColor="@color/LightDarkTheme"
            android:textAllCaps="false"
            app:cornerRadius="54dp"
            app:iconTint="@color/black"
            android:text="@string/search_text_update"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/search_history"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"

        >

        <TextView
            style="@style/SearchErrorTextStyle"
            android:textFontWeight="500"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="@string/search_text_you_searched"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/search_button_clear_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="@color/errorSearch"
            android:fontFamily="@font/ys_display_medium"
            android:textFontWeight="500"
            android:textSize="@dimen/search_text_14"
            android:textColor="@color/LightDarkTheme"
            android:textAllCaps="false"
            app:cornerRadius="54dp"
            app:iconTint="@color/black"
            android:text="@string/search_text_clear_history"
            />

    </LinearLayout>

    <ProgressBar android:id="@+id/search_progress_bar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:layout_marginTop="140dp"
        android:indeterminateTint="@color/blue"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewTracks"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


</androidx.appcompat.widget.LinearLayoutCompat>
