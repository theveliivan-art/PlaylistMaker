<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/LightDarkTheme"
    android:orientation="vertical"
    tools:context=".SearchActivity">

    <LinearLayout
        style="@style/SettingsLinearLayoutStyle"
        android:layout_height="56dp">

        <ImageView
            android:id="@+id/search_back_button"
            android:layout_width="@dimen/image_back_button_w_h"
            android:layout_height="@dimen/image_back_button_w_h"
            android:foreground="?attr/selectableItemBackground"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="@color/LightDarkFont" />

        <TextView
            style="@style/SettingsTextViewStyle"
            android:fontFamily="@font/ys_display_medium"
            android:paddingLeft="12dp"
            android:text="@string/search_text_name"
            android:textFontWeight="500"
            android:textSize="@dimen/main_text_22" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingLeft="@dimen/search_frame_padding_goriz"
        android:paddingTop="@dimen/search_frame_padding_vert"
        android:paddingRight="@dimen/search_frame_padding_goriz"
        android:paddingBottom="@dimen/search_frame_padding_vert">

        <EditText
            android:id="@+id/searchEditText"
            style="@style/SettingsTextViewStyle"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/search_edittext_rounded"
            android:drawableStart="@drawable/ic_search_16"
            android:drawablePadding="8dp"
            android:drawableTint="@color/editTextSearchHint"
            android:hint="@string/search_text_hint"
            android:inputType="text"
            android:paddingStart="10dp"
            android:textColor="@color/black"
            android:textColorHint="@color/editTextSearchHint" />

        <ImageView
            android:id="@+id/clearIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_clear_16"
            android:visibility="gone"
            app:tint="@color/editTextSearchHint" />

    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewTracks"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</androidx.appcompat.widget.LinearLayoutCompat>