<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"  xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".SettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        >
        <ImageView
            android:id="@+id/settings_back_button"
            android:foreground="?attr/selectableItemBackground"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back_24"
            />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingLeft="12dp"
            android:text="@string/button_settings_name"
            android:textColor="@color/black"
            android:textSize="@dimen/main_text_22"
            />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:orientation="vertical">

        <androidx.appcompat.widget.SwitchCompat
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_linerLayout_height"
            android:text="@string/settings_text_blackTheme"
            android:textSize="@dimen/settings_text_16"
            android:paddingLeft="@dimen/settings_text_paddingLeft"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_linerLayout_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            >

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="@dimen/settings_text_paddingLeft"
                android:text="@string/settings_text_share"
                android:textColor="@color/black"
                android:textSize="@dimen/settings_text_16"
                />

            <ImageView
                android:layout_width="@dimen/settings_image_width"
                android:layout_height="@dimen/settings_image_height"
                android:paddingRight="@dimen/settings_image_paddingRight"
                android:src="@drawable/ic_share_24"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_linerLayout_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            >

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="@dimen/settings_text_paddingLeft"
                android:text="@string/settings_text_support"
                android:textColor="@color/black"
                android:textSize="@dimen/settings_text_16"
                />

            <ImageView
                android:layout_width="@dimen/settings_image_width"
                android:layout_height="@dimen/settings_image_height"
                android:paddingRight="@dimen/settings_image_paddingRight"
                android:src="@drawable/ic_support_24"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_linerLayout_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            >

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="@dimen/settings_text_paddingLeft"
                android:text="@string/settings_text_userAgreement"
                android:textColor="@color/black"
                android:textSize="@dimen/settings_text_16"
                />

            <ImageView
                android:layout_width="@dimen/settings_image_width"
                android:layout_height="@dimen/settings_image_height"
                android:paddingRight="@dimen/settings_image_paddingRight"
                android:src="@drawable/ic_arrow_forward_24"
                />
        </LinearLayout>


    </LinearLayout>


</androidx.appcompat.widget.LinearLayoutCompat>