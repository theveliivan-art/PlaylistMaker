<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/playlist_button_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/errorSearch"
        android:fontFamily="@font/ys_display_medium"
        android:textFontWeight="500"
        android:textSize="@dimen/search_text_14"
        android:textColor="@color/LightDarkTheme"
        android:textAllCaps="false"
        app:cornerRadius="54dp"
        app:iconTint="@color/black"
        android:text="@string/mediateka_fav_add_pl"
        android:layout_marginTop="@dimen/padding_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <ImageView
        android:id="@+id/playlist_image_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_nothing_search_120"
        android:paddingTop="@dimen/padding_46"
        android:gravity = "center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playlist_button_add" />
    <TextView
        style="@style/SearchErrorTextStyle"
        android:id="@+id/playlist_text_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/mediateka_fav_empty_pl"
        android:gravity = "center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/playlist_image_empty"/>

</androidx.constraintlayout.widget.ConstraintLayout>